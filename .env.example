# Optionnel : pré-remplir la config au build Vite.
# Si non défini, l'utilisateur saisira ces valeurs depuis l'écran de login.

# URL de base de l'API Doinsport (varie selon le tenant du club)
# VITE_DOINSPORT_BASE_URL=https://api-principale.doinsport.club

# ID du club (à demander à Doinsport ou trouver dans l'URL back-office)
# VITE_DOINSPORT_CLUB_ID=
